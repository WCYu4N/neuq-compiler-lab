Grammar

    0 $accept: CompUnit $end

    1 CompUnit: DeclAndFuncPart

    2 DeclAndFuncPart: Decl DeclAndFuncPart
    3                | FuncAndMainPart

    4 FuncAndMainPart: FuncDef FuncAndMainPart
    5                | MainFuncDef

    6 Decl: ConstDecl
    7     | VarDecl

    8 FuncDef: BType Ident LPARENT OptionalFuncFParams RPARENT Block
    9        | VOIDTK Ident LPARENT OptionalFuncFParams RPARENT Block

   10 OptionalFuncFParams: %empty
   11                    | FuncFParams

   12 MainFuncDef: INTTK MAINTK LPARENT RPARENT Block

   13 ConstDecl: CONSTTK BType ConstDefList SEMICN

   14 ConstDefList: ConstDef
   15             | ConstDefList COMMA ConstDef

   16 VarDecl: BType VarDefList SEMICN

   17 VarDefList: VarDef
   18           | VarDefList COMMA VarDef

   19 Ident: IDENFR

   20 FuncFParams: FuncFParamList

   21 FuncFParamList: FuncFParam
   22               | FuncFParamList COMMA FuncFParam

   23 Block: LBRACE BlockItemList RBRACE

   24 BlockItemList: %empty
   25              | BlockItemList BlockItem

   26 BType: INTTK

   27 VarDef: Ident BrackConstExpList
   28       | Ident BrackConstExpList ASSIGN InitVal

   29 FuncFParam: BType Ident OptionalParamArray

   30 OptionalParamArray: %empty
   31                   | LBRACK RBRACK BrackConstExpList

   32 BlockItem: Decl
   33          | Stmt

   34 ConstExp: AddExp

   35 InitVal: Exp
   36        | LBRACE OptionalInitVal RBRACE

   37 OptionalInitVal: %empty
   38                | InitVal InitValList

   39 InitValList: %empty
   40            | InitValList COMMA InitVal

   41 Stmt: LVal ASSIGN Exp SEMICN
   42     | OptionalExp SEMICN
   43     | Block
   44     | IFTK LPARENT Cond RPARENT Stmt OptionalElseStmt
   45     | WHILETK LPARENT Cond RPARENT Stmt
   46     | BREAKTK SEMICN
   47     | CONTINUETK SEMICN
   48     | RETURNTK OptionalExp SEMICN
   49     | LVal ASSIGN GETINTTK LPARENT RPARENT SEMICN
   50     | PRINTFTK LPARENT FormatString CommaExpList RPARENT SEMICN

   51 OptionalExp: %empty
   52            | Exp

   53 OptionalElseStmt: %empty
   54                 | ELSETK Stmt

   55 CommaExpList: %empty
   56             | CommaExpList COMMA Exp

   57 AddExp: MulExp
   58       | AddExp PLUS MulExp
   59       | AddExp MINU MulExp

   60 Exp: AddExp

   61 LVal: Ident BrackExpList

   62 BrackExpList: %empty
   63             | BrackExpList LBRACK Exp RBRACK

   64 Cond: LOrExp

   65 FormatString: STRCON

   66 MulExp: UnaryExp
   67       | MulExp MULT UnaryExp
   68       | MulExp DIV UnaryExp
   69       | MulExp MOD UnaryExp

   70 LOrExp: LAndExp
   71       | LOrExp OR LAndExp

   72 LAndExp: EqExp
   73        | LAndExp AND EqExp

   74 EqExp: RelExp
   75      | EqExp EQL RelExp
   76      | EqExp NEQ RelExp

   77 UnaryExp: PrimaryExp
   78         | Ident LPARENT OptionalFuncRParams RPARENT
   79         | UnaryOp UnaryExp

   80 OptionalFuncRParams: %empty
   81                    | FuncRParams

   82 RelExp: AddExp
   83       | RelExp LSS AddExp
   84       | RelExp GRE AddExp
   85       | RelExp LEQ AddExp
   86       | RelExp GEQ AddExp

   87 PrimaryExp: LPARENT Exp RPARENT
   88           | LVal
   89           | Number

   90 FuncRParams: Exp CommaExpList

   91 Number: IntConst

   92 IntConst: INTCON

   93 UnaryOp: PLUS
   94        | MINU
   95        | NOT

   96 ConstInitVal: ConstExp
   97             | LBRACE OptionalConstInitVal RBRACE

   98 OptionalConstInitVal: %empty
   99                     | ConstInitVal CommaConstInitValList

  100 CommaConstInitValList: %empty
  101                      | CommaConstInitValList COMMA ConstInitVal

  102 ConstDef: Ident BrackConstExpList
  103         | Ident BrackConstExpList ASSIGN ConstInitVal

  104 BrackConstExpList: %empty
  105                  | BrackConstExpList LBRACK ConstExp RBRACK


